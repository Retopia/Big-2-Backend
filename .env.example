# Server
PORT=3002

# Postgres account/rating storage
DATABASE_URL=
# Set to require for hosted Postgres providers that require TLS.
PGSSLMODE=

# Socket reconnect grace period for mobile app switching/backgrounding.
SOCKET_RECONNECT_GRACE_MS=120000

# OpenRouter / LLM AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=x-ai/grok-4-fast
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Big 2 Live

# Admin auth (set one; hash is preferred)
# Optional but recommended: explicit secret used to sign stateless admin auth tokens.
ADMIN_AUTH_SECRET=
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=change-me
